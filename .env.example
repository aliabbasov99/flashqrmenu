# BACKEND (Render / Railway / Fly və s.) -> Environment Variables
# Backend ayrıca deploy olunur: root = backend, start = node server.js

# MongoDB Atlas
MONGODB_URI="mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net"
# (istəyə bağlı) bazanın adı, default: qrmenu
MONGODB_DB="qrmenu"

# Cloudinary (cloudinary://API_KEY:API_SECRET@CLOUD_NAME)
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# Token imzalamaq üçün gizli açar (uzun təsadüfi sətir)
SECRET="dəyiş-məni-uzun-təsadüfi-strinq"

# Super admin girişi (/admin)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="jaguar"

# FRONTEND (Vercel) -> Environment Variables
# Backend-in tam ünvanı (/api daxil olmaqla)
VITE_API_URL="https://backend-adin.onrender.com/api"
